        "@octokit/rest": "^22.0.1",
        "@types/node": "^26.6.5",
        "@types/semver": "^7.8.0",
        "oxfmt": "^0.74.0",
        "oxlint": "^1.89.0",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
